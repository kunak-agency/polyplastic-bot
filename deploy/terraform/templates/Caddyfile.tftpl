# Сгенерировано Terraform (deploy/terraform/templates/Caddyfile.tftpl). Руками не править.
%{ if acme_email != "" ~}
{
	email ${acme_email}
}
%{ endif ~}

# basic_auth_enabled: весь сайт за basic auth (до входа по ролям). С FEATURE_AUTH кабинет и API
# закрыты собственным входом, basic auth выключается переменной.
(protected) {
%{ if basic_auth_enabled ~}
	basic_auth {
		${user} ${hash}
	}
%{ endif ~}
	encode zstd gzip
	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}

(api) {
	reverse_proxy api:8081 {
		# Загрузка и разбор документов базы знаний идут минутами (KB_UPLOAD_TIMEOUT 3 мин).
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}

# Кабинет: SPA с фолбэком на index.html, /api/* → API.
${join(", ", web_domains)} {
	import protected

	handle /api/* {
		import api
	}

	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
	}
}
%{ if api_domain != "" ~}

# Отдельный домен API: всё → API, тот же basic auth.
${api_domain} {
	import protected
	import api
}
%{ endif ~}
%{ if call_domain != "" ~}

# «Позвонить Корсику»: страница call.html и WebSocket звонка, всегда за своим basic auth.
# Наружу из API отдаётся только /api/call; WS идёт без таймаутов чтения (звонок до 5 минут).
${call_domain} {
	basic_auth {
		${call_user} ${call_hash}
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	handle /api/call {
		reverse_proxy api:8081 {
			stream_close_delay 5s
		}
	}

	handle /api/* {
		respond 404
	}

	handle {
		encode zstd gzip
		root * /srv/site
		try_files {path} /call.html
		file_server
	}
}
%{ endif ~}
