# Скопировать в .env и заполнить. .env в git не попадает.

# Бот MAX (business.max.ru / dev.max.ru)
MAX_BOT_TOKEN=

# RunPod: ключ API для управления подом с vLLM
RUNPOD_API_KEY=

# LLM на поде (vLLM, OpenAI-совместимый API), как в hack-ru-clinik
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=tlite
LLM_TEMPERATURE=0.2
LLM_PRESENCE_PENALTY=1.0

# Postgres из docker-compose (локально, порт 5437)
DATABASE_URL=

# Бэкенд: сколько бот ждёт ответ rag на вопрос новичка (Go duration); пусто — 12s
RAG_ASK_TIMEOUT=
# Обращения: групповые чаты MAX для карточек (HR-чат, чат СБ для F5/F9); пусто — только лог
MAX_HR_CHAT_ID=
MAX_SB_CHAT_ID=
# rag: LLM-разметка флагов (POST /flags); пусто — temperature 0.1, max_tokens 200, срок 10 с
FLAGS_TEMPERATURE=
FLAGS_MAX_TOKENS=
FLAGS_TIMEOUT_S=
# Бэкенд: срок POST /flags (в фоне, Go duration); пусто — 25s
RAG_FLAGS_TIMEOUT=

# ---- Демо-стек (make demo, docker-compose.demo.yml) ----
# Имя бота в MAX без @ — для ссылки-приглашения (нужно только с MAX_BOT_TOKEN)
MAX_BOT_USERNAME=
# Порты на 127.0.0.1; пусто — кабинет 18080, API 18081, RAG 18093, Postgres 15440
DEMO_WEB_PORT=
DEMO_API_PORT=
DEMO_RAG_PORT=
DEMO_PG_PORT=
# 0.0.0.0 — открыть кабинет в сеть (стенд); пусто — только 127.0.0.1
DEMO_BIND=
# Корпус RAG: synthetic (по умолчанию, в образе) | real — services/rag/corpus-real/ с хоста
RAG_CORPUS=
# Бюджет ответа LLM в RAG, секунды; пусто — 6. Не уложился — дословная цитата пункта
LLM_TIMEOUT=
