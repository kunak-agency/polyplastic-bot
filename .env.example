# Скопировать в .env и заполнить. .env в git не попадает.

# Бот MAX (business.max.ru / dev.max.ru)
MAX_BOT_TOKEN=

# RunPod: ключ API для управления подом с vLLM
RUNPOD_API_KEY=

# LLM на поде (vLLM, OpenAI-совместимый API), как в hack-ru-clinik
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=tlite
LLM_TEMPERATURE=0.2
LLM_PRESENCE_PENALTY=1.0

# Postgres из docker-compose (локально, порт 5437)
DATABASE_URL=

# Бэкенд: сколько бот ждёт ответ rag на вопрос новичка (Go duration); пусто — 8s
RAG_ASK_TIMEOUT=
# Обращения: групповые чаты MAX для карточек (HR-чат, чат СБ для F5/F9); пусто — только лог
MAX_HR_CHAT_ID=
MAX_SB_CHAT_ID=
