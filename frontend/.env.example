VITE_API_BASE_URL=http://localhost:8081/api
VITE_APP_NAME=Корсик
# Set to "true" to serve API endpoints from the in-bundle mock adapter instead of
# the real backend. Development only — never enable for a deployed build.
VITE_USE_MOCKS=false
# Send the session cookie to a cross-origin API (dev with an absolute
# VITE_API_BASE_URL). Needs AllowCredentials in the backend CORS; with
# VITE_API_BASE_URL=/api (Vite proxy) it is not needed.
VITE_API_WITH_CREDENTIALS=false
# Mocks only: "false" makes /auth/me answer 404, i.e. FEATURE_AUTH=false.
VITE_MOCK_AUTH=true
