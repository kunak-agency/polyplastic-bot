{
  "name": "polyplastic-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -b --noEmit",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,js,jsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,tsx,js,jsx,css,md}\"",
    "check:build-output": "node scripts/check-build-output.mjs",
    "check:cyrillic": "node scripts/check-cyrillic.mjs",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^5.6.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "qrcode": "1.5.4",
    "reka-ui": "^2.9.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.44",
    "vue-echarts": "^7.0.3",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/qrcode": "1.5.5",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.9.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vue-tsc": "^3.2.8"
  },
  "pnpm": {
    "overrides": {
      "follow-redirects": ">=1.16.1",
      "source-map-js": ">=1.2.2"
    }
  }
}
