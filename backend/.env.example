# Пример окружения API и бота. Значений секретов здесь нет: `make env` создаёт backend/.env
# для локального запуска с Postgres из docker-compose.yml, остальное — вручную.
# Файл .env в git не попадает. Все переменные читает один пакет — backend/config.

# HTTP. Голый номер — только 127.0.0.1; в контейнере 0.0.0.0:8081
PORT=8081
APP_ENV=development
# Через запятую; пусто — только dev-сервер фронта http://localhost:5173
ORIGINS=

# Postgres (docker-compose, порт 5437). Формат: postgres://<user>:<password>@<host>:<port>/<db>?sslmode=disable
# Пусто — сервис стартует без базы (WARN), /api/health отвечает db: down.
DATABASE_URL=

# Бот MAX (business.max.ru / dev.max.ru). Пусто — бот не стартует (WARN), HTTP работает.
MAX_BOT_TOKEN=
# Корневой сертификат Минцифры (PEM или DER), добавляется к системному пулу; пусто — системный пул
MAX_CA_FILE=
# Сколько MAX держит GET /updates без событий (Go duration); пусто — 30s
MAX_POLL_TIMEOUT=

# Имя бота в MAX для ссылки-приглашения (без @); пусто — в ссылке заглушка your_bot
MAX_BOT_USERNAME=
# Формат deep link: первый %s — имя бота, второй — inv_<token>. Пусто — https://max.ru/%s?start=%s.
# Формат не проверен на телефоне; второй вариант — https://max.ru/%s/start/%s
INVITE_LINK_FORMAT=
# Сколько живёт приглашение после даты выхода (Go duration); пусто — 720h
INVITE_TTL=
# Такт планировщика таймлайна и пауза между сообщениями пакета одному новичку; пусто — 30s и 2s
SCHEDULER_INTERVAL=
SCHEDULER_PACK_GAP=
# Без MAX_BOT_TOKEN при APP_ENV=development бот работает на подделке MAX (сообщения — в лог).

# RAG-сервис services/rag (make up)
RAG_BASE_URL=http://localhost:8093
# Общий ключ rag (Authorization: Bearer), тот же, что RAG_API_KEY у services/rag. Пусто — без
# ключа (локальный rag). Обязателен, когда rag на публичном адресе (под RunPod).
RAG_API_KEY=
# Срок проверки rag в /api/health; пусто — 2s
RAG_HEALTH_TIMEOUT=
# Сколько бот ждёт ответ rag на вопрос новичка (POST /ask, Go duration); пусто — 12s.
# Дольше — новичок получает «ищу дольше обычного», поздний ответ бот досылает (ещё до 20 с).
RAG_ASK_TIMEOUT=

# Обращения (итерация 3). Групповые чаты MAX для карточек: HR-чат и чат СБ (F5/F9).
# chat_id видно в логе API, когда бота добавляют в чат (bot_added). Пусто — карточка только в лог.
MAX_HR_CHAT_ID=
MAX_SB_CHAT_ID=
# Таксономия флагов F0–F10 (маршруты, приоритеты, видимость); пусто — data/taxonomy.yaml от
# рабочего каталога (корень репозитория или backend/). Нет файла — API не стартует.
TAXONOMY_PATH=

# LLM на поде (vLLM, OpenAI-совместимый API), как в hack-ru-clinik
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=tlite
LLM_TEMPERATURE=0.2
LLM_PRESENCE_PENALTY=1.0
# Срок POST /flags (LLM-разметка флагов в фоне, Go duration); пусто — 25s
RAG_FLAGS_TIMEOUT=

# База знаний (api_contract.md, «v3 — база знаний»). Потолок файла на backend (МБ, ≤ 25; пусто — 20),
# срок загрузки в rag (Go duration; пусто — 3m) и секрет заголовка X-Operator-Token: ролей нет,
# вне development раздел открыт только с ним; пусто — закрыт.
KB_MAX_UPLOAD_MB=
KB_UPLOAD_TIMEOUT=
KB_OPERATOR_TOKEN=

# Фича-флаги итерации 24.10: true — включён; пусто — выключен. Включаются по одному после
# прогона на телефоне в порядке REPLIES → AUTH → TZ → NUDGES_DEFAULT → CATCHUP; откат — пусто.
# Ответы бота реплаем на сообщение новичка (при ошибке — повтор без link)
FEATURE_REPLIES=
# Вход в кабинет: логин/пароль, роли hr_lead | recruiter | manager, сессии в Postgres
FEATURE_AUTH=
# Пояс новичка и площадки в расписании, окно 8:00–18:00 пн–пт, праздники
FEATURE_TZ=
# Авто-напоминания о неотвеченном вопросе: 4 ч и 24 ч в рабочее время, не больше 1 в день
FEATURE_NUDGES_DEFAULT=
# Догоняющая очередь позднего входа: обязательные вопросы по одному блоку в день
FEATURE_CATCHUP=
# Зоны риска v2 (одна зона и причина), push руководителю v2 (D+1 план, D+14, D+87 с решением по ИС,
# не больше 2 в неделю и 1 в день), утренняя сводка рекрутеру в 9:00 (нужен users.max_user_id)
FEATURE_RISK_V2=
# Уточняющий вопрос по шаблону категории после тревожного ответа опроса («С кем именно сложно?»
# и т. п.), не больше 1 на ответ, 2 на опрос и 1 в сутки; не во время диалога с HR
FEATURE_CLARIFY=
